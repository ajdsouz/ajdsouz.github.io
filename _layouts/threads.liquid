---
layout: distill
---

<article class="post thread-page">

  <!-- Thread Body -->
  <section class="post-body">
    {{ content }}
  </section>

  <!-- Thread Posts Index -->
  {% if page.thread %}
  {% assign thread_posts = site.posts
      | where: "thread", page.thread
      | sort: "thread_order" %}

  <section class="thread-posts">
    <h2>Posts in this Thread</h2>

    {% for post in thread_posts %}
      {% if post.url != page.url %}
      <div class="thread-post-card">
        <h3><a href="{{ post.url }}">{{ post.title }}</a></h3>

        {% if post.author %}
        <p class="thread-post-author">By {{ post.author }}</p>
        {% endif %}

        {% if post.description %}
        <p class="thread-post-description">{{ post.description }}</p>
        {% endif %}
      </div>
      {% endif %}
    {% endfor %}
  </section>
  {% endif %}

</article>

<style>
.thread-page { margin-top: 2rem; }

.thread-posts {
  margin-top: 3rem;
  border-top: 1px solid var(--global-divider-color);
  padding-top: 2rem;
}

.thread-post-card {
  margin-bottom: 2rem;
  padding: 1rem;
  border: 1px solid var(--global-divider-color);
  border-radius: 12px;
  background: var(--global-bg-color);
}

.thread-post-card h3 { margin-bottom: 0.5rem; }

.thread-post-author {
  font-size: 0.85rem;
  color: var(--global-text-color-light);
  margin-bottom: 0.5rem;
}

.thread-post-description {
  font-size: 1rem;
  line-height: 1.5;
}
</style>
